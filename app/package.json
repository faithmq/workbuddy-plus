{
  "name": "workbuddy-plus",
  "version": "1.0.0",
  "description": "Workbuddy Plus —— 给 WorkBuddy 自动化定时调度增加分钟/秒级颗粒度",
  "main": "main.js",
  "productName": "Workbuddy Plus",
  "scripts": {
    "start": "npm run sync-hooks && electron .",
    "sync-hooks": "node scripts/sync-hooks.js",
    "dist": "npm run sync-hooks && electron-builder"
  },
  "build": {
    "appId": "com.workbuddy.plus",
    "productName": "Workbuddy Plus",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "Workbuddy Plus ${version}"
    }
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^25.0.0"
  }
}
